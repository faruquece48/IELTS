Windows Registry Editor Version 5.00

; One-time setup: double-click this file, then click "Yes"/"OK" on the prompts.
; It registers the "ieltsdownloader://" link protocol for your Windows user account only
; (no admin rights needed), pointing to launch-protocol.bat in this same folder.
;
; After this, the "Download" page on the website (even the deployed/online version) can
; launch your local downloader server by opening an "ieltsdownloader://start" link -
; Windows will ask you to confirm opening it the first time.

[HKEY_CURRENT_USER\Software\Classes\ieltsdownloader]
@="URL:IELTS Downloader Protocol"
"URL Protocol"=""

[HKEY_CURRENT_USER\Software\Classes\ieltsdownloader\shell]

[HKEY_CURRENT_USER\Software\Classes\ieltsdownloader\shell\open]

[HKEY_CURRENT_USER\Software\Classes\ieltsdownloader\shell\open\command]
@="\"C:\\Users\\HP\\Downloads\\IELTS\\app\\Downloader\\launch-protocol.bat\" \"%1\""
