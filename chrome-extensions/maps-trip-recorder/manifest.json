{
  "manifest_version": 3,
  "name": "Maps Trip Time Recorder",
  "version": "1.3.2",
  "description": "Capture and save route times from Google Maps.",
  "permissions": ["storage", "activeTab", "scripting", "downloads", "alarms", "tabs", "debugger"],
  "host_permissions": ["https://www.google.com/maps/*", "https://maps.google.com/*", "https://www.google.com.bd/maps/*"],
  "action": {
    "default_title": "Save Google Maps trip",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.google.com/maps/*", "https://maps.google.com/*", "https://www.google.com.bd/maps/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*", "https://*.vercel.app/personal/traffic*"],
      "js": ["traffic-bridge.js"],
      "run_at": "document_start"
    }
  ]
}
